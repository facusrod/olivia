# ===========================================
# Olivia - Variables de entorno (Desarrollo Local)
# ===========================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env

# Next.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-esto-con-openssl-rand-base64-32

# Google OAuth
# Instrucciones: https://console.cloud.google.com/ > APIs & Services > Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# Gemini AI
GEMINI_API_KEY=tu-gemini-api-key

# MongoDB (local via docker-compose.dev.yml)
MONGODB_URI=mongodb://localhost:27017/olivia

# Odoo 18 (local via docker-compose.dev.yml)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Vercel Cron - protege /api/cron/*. En local podes probar el endpoint con:
# curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/expired-products
CRON_SECRET=genera-esto-con-openssl-rand-base64-32

# Web Push (notificaciones de Pedidos Pendientes) - genera el par de claves con:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# Webhook entrante de Odoo (Regla de automatizacion -> Enviar notificacion webhook)
# En local podes probar el endpoint con:
# curl -X POST "http://localhost:3000/api/webhooks/odoo?secret=$ODOO_WEBHOOK_SECRET" -d '{"id":1,"name":"S00001"}'
ODOO_WEBHOOK_SECRET=genera-esto-con-openssl-rand-base64-32
