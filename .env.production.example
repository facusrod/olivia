# ===========================================
# Olivia - Variables de entorno (Produccion - Vercel)
# ===========================================
# Estas variables se configuran en Vercel > Settings > Environment Variables

# Next.js / NextAuth
NEXTAUTH_URL=https://olivia.tu-dominio.com
NEXTAUTH_SECRET=genera-esto-con-openssl-rand-base64-32

# Google OAuth
# Authorized redirect URI: https://olivia.tu-dominio.com/api/auth/callback/google
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# Gemini AI
GEMINI_API_KEY=tu-gemini-api-key

# MongoDB Atlas (Free Tier M0)
MONGODB_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/olivia?retryWrites=true&w=majority

# Odoo 18 (produccion)
# Opcion 1: Via Cloudflare Zero Trust (necesita Service Token)
ODOO_URL=https://odoo.tu-dominio.com
# Opcion 2: Subdominio API sin Zero Trust
# ODOO_URL=https://api.tu-dominio.com
ODOO_DB=odoo
ODOO_USERNAME=tu-usuario-odoo
ODOO_PASSWORD=tu-password-odoo

# Cloudflare Zero Trust Service Token (si usas opcion 1)
# CF_ACCESS_CLIENT_ID=tu-service-token-id
# CF_ACCESS_CLIENT_SECRET=tu-service-token-secret

# Vercel Cron - protege /api/cron/*. Vercel manda este valor automaticamente
# como header "Authorization: Bearer <CRON_SECRET>" en cada invocacion.
CRON_SECRET=genera-esto-con-openssl-rand-base64-32

# Web Push (notificaciones de Pedidos Pendientes) - genera el par de claves con:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# Webhook entrante de Odoo (Regla de automatizacion -> Enviar notificacion webhook).
# Configurar en Odoo la URL https://olivia.tu-dominio.com/api/webhooks/odoo con
# header "Authorization: Bearer <ODOO_WEBHOOK_SECRET>", o si el dialogo no permite
# headers custom, como query param: .../api/webhooks/odoo?secret=<ODOO_WEBHOOK_SECRET>
ODOO_WEBHOOK_SECRET=genera-esto-con-openssl-rand-base64-32
