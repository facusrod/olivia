# Ejemplo de archivo .env para producción
# Copia este archivo como .env.production y completa los valores

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-esto-con-openssl-rand-base64-32

# Google OAuth
GOOGLE_CLIENT_ID=tu-client-id
GOOGLE_CLIENT_SECRET=tu-client-secret

# Gemini AI
GEMINI_API_KEY=tu-gemini-api-key

# MongoDB (el docker-compose se encarga de esto)
MONGODB_URI=mongodb://mongodb:27017/olivia

# Odoo (debe ser accesible desde el contenedor)
# Si Odoo está en el mismo host, usa host.docker.internal
ODOO_URL=http://host.docker.internal:8080
ODOO_DB=odoo
ODOO_USERNAME=tu-usuario-odoo
ODOO_PASSWORD=tu-password-odoo
